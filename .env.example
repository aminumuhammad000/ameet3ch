# ==============================================================================
# Ameetech Business & Economics Academy — Environment Configuration Example
# Copy this file to .env and supply actual provider credentials.
# ==============================================================================

# Application Security
ACADEMY_PORT=8080
ACADEMY_SECRET_KEY=replace-with-a-secure-random-64-character-string

# Admin Portal Authentication (Basic Auth)
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-strong-admin-password

# Transactional Email Provider (Choose Resend or SendGrid)
# https://resend.com or https://sendgrid.com
RESEND_API_KEY=re_your_resend_api_key_here
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
TRANSACTIONAL_FROM_EMAIL=academy@ameetechnology.com.ng

# WhatsApp Business Cloud API (Official Meta Graph API)
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_CLOUD_API_TOKEN=EAAG...your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=109283746592019
WHATSAPP_TEMPLATE_NAME=academy_study_guide_delivery
WHATSAPP_TEMPLATE_LANG=en

# ==============================================================================
# Ameetech Bulk Flyer Generation Tool Configuration
# Copy this file to .env and configure your desired image generation provider.
# Default is 'local' (offline branded compositor, no API key or costs required).
# ==============================================================================

# Active Provider: 'local', 'openai', 'stability', 'imagen', or 'mock'
FLYER_PROVIDER=local

# Concurrency & Batch Settings
FLYER_CONCURRENCY=2
FLYER_BATCH_SIZE=10
FLYER_MAX_RETRIES=3

# Provider 1: OpenAI DALL-E (Required if FLYER_PROVIDER=openai)
# Model options: 'dall-e-3' ($0.040/image) or 'dall-e-2' ($0.020/image)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_IMAGE_MODEL=dall-e-3

# Provider 2: Stability AI (Required if FLYER_PROVIDER=stability)
# SD3 / Stable Image Core (~$0.030/image)
STABILITY_API_KEY=sk-your-stability-api-key-here

# Provider 3: Google Imagen (Required if FLYER_PROVIDER=imagen)
GEMINI_API_KEY=your-gemini-or-google-api-key-here
# GOOGLE_API_KEY=your-gemini-or-google-api-key-here

